<Window x:Class="WpfApp1.Views.Window3"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:WpfApp1.Views"
        xmlns:helix="http://helix-toolkit.org/wpf"
        mc:Ignorable="d"
        Title="Window3" Height="550" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350" /> <!-- Or Auto -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Button Content="Load 3D Model" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Click="LoadModelButton_Click" />
        <helix:HelixViewport3D x:Name="HelixViewport3D"  Grid.Column="1">
            <!-- Camera -->
            <helix:HelixViewport3D.Camera>
                <PerspectiveCamera Position="0, 0, 5" LookDirection="0, 0, -1" UpDirection="0, 1, 0" FieldOfView="45" />
            </helix:HelixViewport3D.Camera>

            <!-- Lighting -->
            <helix:DefaultLights />

            <!-- 3D Object -->
        </helix:HelixViewport3D>
    </Grid>
</Window>
