<Window x:Class="WpfApp1.Views.Window3"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:WpfApp1.Views"
        xmlns:helix="http://helix-toolkit.org/wpf"
        mc:Ignorable="d"
        Title="Window3" Height="550" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        
        <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Vertical">
            <TextBlock Foreground="White">Loading Model</TextBlock>
            <ProgressBar Width="200" Height="30" IsIndeterminate="True" />
            <Menu VerticalAlignment="Top">
                <MenuItem Header="File">
                    <MenuItem Click="LoadModelButton_Click" Header="Open File" />
                    <MenuItem Command="{Binding ExportCommand}" Header="Export" />
                </MenuItem>
                <MenuItem Header="Edit">
                    <MenuItem Command="{Binding CopyAsBitmapCommand}" Header="Copy As Bitmap (Window Size)" />
                    <MenuItem Command="{Binding CopyAsHiresBitmapCommand}" Header="Copy as Hiresolution Bitmap (1920x1080)" />
                </MenuItem>
            </Menu>
        </StackPanel>

        <helix:HelixViewport3D x:Name="HelixViewport3D" Grid.Column="1">
            <!-- Camera -->
            <helix:HelixViewport3D.Camera>
                <PerspectiveCamera Position="0, 0, 5" LookDirection="0, 0, -1" UpDirection="0, 1, 0" FieldOfView="45" />
            </helix:HelixViewport3D.Camera>

            <!-- Lighting -->
            <helix:DefaultLights />
        </helix:HelixViewport3D>
                <StackPanel Orientation="Vertical" HorizontalAlignment="Left">
                    <Button Content="Rotate Left" Click="RotateLeft_Click"/>
                    <Button Content="Rotate Right" Click="RotateRight_Click"/>
                    <Button Content="Rotate Up" Click="RotateUp_Click"/>
                    <Button Content="Rotate Down" Click="RotateDown_Click"/>
                    <Button Content="Upload 3D Model" Click="UploadModel_Click"/>
                </StackPanel>
    </Grid>
</Window>
