<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        xmlns:controls="clr-namespace:WpfApp1.Views.Controls"
        mc:Ignorable="d"
        Title="MainWindow" Height="800" Width="800">

    <Grid>
        <!-- <Separator /> -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- For the Menu -->
            <RowDefinition Height="*" />    <!-- For the main content -->
        </Grid.RowDefinitions>


        <!-- Menu -->
        <Menu Grid.Row="0">
            <MenuItem Header="File" PreviewMouseLeftButtonDown="MenuItem_PreviewMouseLeftButtonDown" x:Name="MainMenu">
                <MenuItem Header="Open" />
                <MenuItem Header="Save" />
            </MenuItem>
        </Menu>
        <StackPanel Grid.Row="0" Margin="10">
            <controls:CustomInputControl x:Name="CustomInputControlInstance" HorizontalAlignment="Center"
                                         VerticalAlignment="Center" />
            <TextBlock Text="Hello, world!" FontSize="56" />
            <TextBlock>Just another "<TextBlock Text="Hello, world!" />" example, but with resources!</TextBlock>
            <TextBox x:Name="InputTextBox"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Top"
                     Margin="0,0,0,10"
                     Height="30" />
            <Button HorizontalAlignment="Center" Height="30px" Width="100px" Click="Button_Click"
                    Content="something" />
            <Button HorizontalAlignment="Center" Height="30px" Width="100px" Click="ButtonBase_OnClick"
                    Content="window2" />
            <!-- <Button VerticalAlignment="Bottom" Height="30px" Width="100px" Click="Button_Click" Content="something" /> -->
            <ListBox x:Name="TextListBox" Width="100px" MinHeight="50px" Margin="0px 50px 0px 100px"
                     VerticalAlignment="Bottom" />
            <Button Height="35px" Width="100px" Content="What?" Click="What_Button" />
            <Button Height="35px" Width="100px" Content="3D stuffs" Click="Open_3D_Stuffs" />
            <ComboBox Height="23" Margin="0 50px" Name="ComboBox1" SelectionChanged="ComboBox1_SelectionChanged"
                      Width="120">
                <ComboBoxItem Content="Alice" />
                <ComboBoxItem Content="Bob" />
                <ComboBoxItem Content="Charlie" />
            </ComboBox>
            <TextBlock Text="Enter scale (e.g., C Major, A Minor)"></TextBlock>
            <TextBox x:Name="ScaleInput"  Margin="10" />
            <Button Content="Highlight Scale" Click="HighlightScale_Click" Margin="10" />
            <TextBlock x:Name="ScaleNotesDisplay" Margin="10" />
        </StackPanel>
        <Grid Grid.Row="1">
            <!-- White Keys -->
            <StackPanel  x:Name="PianoKeys" Orientation="Horizontal">
                <Button Content="C" Click="PlayNote" Tag="C.wav" Width="50" Height="150" Margin="0,0,0,0" />
                <Button Content="D" Click="PlayNote" Tag="D.wav" Width="50" Height="150" Margin="0,0,0,0" />
                <Button Content="E" Click="PlayNote" Tag="E.wav" Width="50" Height="150" Margin="0,0,0,0" />
                <Button Content="F" Click="PlayNote" Tag="F.wav" Width="50" Height="150" Margin="0,0,0,0" />
                <Button Content="G" Click="PlayNote" Tag="G.wav" Width="50" Height="150" Margin="0,0,0,0" />
                <Button Content="A" Click="PlayNote" Tag="A.wav" Width="50" Height="150" Margin="0,0,0,0" />
                <Button Content="B" Click="PlayNote" Tag="B.wav" Width="50" Height="150" Margin="0,0,0,0" />
            </StackPanel>

            <!-- Black Keys -->
            <StackPanel Orientation="Horizontal" Margin="15,0,0,0">
                <Button Content="C#" Click="PlayNote" Tag="C#.wav" Width="30" Height="100" Background="Black"
                        Foreground="White" Margin="20,0,0,0" />
                <Button Content="D#" Click="PlayNote" Tag="D#.wav" Width="30" Height="100" Background="Black"
                        Foreground="White" Margin="20,0,0,0" />
                <Button Content="" Width="50" Background="Transparent" IsHitTestVisible="False" />
                <!-- Spacer for E -->
                <Button Content="F#" Click="PlayNote" Tag="F#.wav" Width="30" Height="100" Background="Black"
                        Foreground="White" Margin="20,0,0,0" />
                <Button Content="G#" Click="PlayNote" Tag="G#.wav" Width="30" Height="100" Background="Black"
                        Foreground="White" Margin="20,0,0,0" />
                <Button Content="A#" Click="PlayNote" Tag="A#.wav" Width="30" Height="100" Background="Black"
                        Foreground="White" Margin="20,0,0,0" />
                <Button Content="" Width="50" Background="Transparent" IsHitTestVisible="False" />
                <!-- Spacer for B -->
            </StackPanel>
        </Grid>

    </Grid>
</Window>
