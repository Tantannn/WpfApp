<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Grid>
        <StackPanel Margin="10">
            <TextBlock Text="Hello, world!" FontSize="56" />
            <TextBlock>Just another "<TextBlock Text="Hello, world!" />" example, but with resources!</TextBlock>
        </StackPanel>
        <TextBox x:Name="InputTextBox"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Top"
                 Margin="0,0,0,10"
                 Height="30" />
        <Button HorizontalAlignment="Center" Height="30px" Width="100px" Click="Button_Click"
                Content="something" />
        <!-- <Button VerticalAlignment="Bottom" Height="30px" Width="100px" Click="Button_Click" Content="something" /> -->
        <ListBox x:Name="TextListBox" Width="50px" Margin="0px 0px 0px 100px"
                 VerticalAlignment="Bottom" />
    </Grid>
</Window>
